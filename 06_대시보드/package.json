{
  "name": "care-resource-lab-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts --open /static-index.html",
    "build": "vite build --config vite.static.config.ts",
    "preview": "vite preview --config vite.static.config.ts --open /static-index.html",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app components lib views tests static-main.tsx vite.static.config.ts",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
